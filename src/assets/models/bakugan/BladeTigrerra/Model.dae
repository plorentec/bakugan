 <library_effects>
  <effect id="mat1.png-fx" name="mat1.png-fx">
   <profile_COMMON>
    <newparam sid="texture1-surface">
     <surface type="2D">
      <init_from>texture1</init_from>
     </surface>
    </newparam>
    <newparam sid="texture1-sampler">
    <sampler2D>
     <source>texture1-surface</source>
     <minfilter>LINEAR</minfilter>
     <magfilter>LINEAR</magfilter>
    </sampler2D>
   </newparam>
    <technique sid="metaseq">
     <lambert>
      <emission>
       <color>0.500 0.500 0.500 1</color>
      </emission>
      <ambient>
       <color>0.000 0.000 0.000 1</color>
      </ambient>
      <diffuse>
       <texture texture="texture1-sampler" texcoord="UVSET0"/>
      </diffuse>
      <reflective>
       <color>1 1 1 1</color>
      </reflective>
      <reflectivity>
       <float>0.0</float>
      </reflectivity>
      <transparent>
       <color>1 1 1 1</color>
      </transparent>
      <transparency>
       <float>1.000</float>
      </transparency>
     </lambert>
    </technique>
   </profile_COMMON>
  </effect>
