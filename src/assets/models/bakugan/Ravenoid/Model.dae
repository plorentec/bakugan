      <specular>
       <color>0.000 0.000 0.000 1</color>
      </specular>
      <shininess>
       <float>0.000</float>
      </shininess>
      <reflective>
       <color>1 1 1 1</color>
      </reflective>
      <reflectivity>
       <float>0.0</float>
      </reflectivity>
      <transparent>
       <color>1 1 1 1</color>
      </transparent>
      <transparency>
